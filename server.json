{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.bharat2808/gsheets-local-plugin",
  "description": "Search and safely update native Google Sheets from selected My Drive folders.",
  "status": "active",
  "repository": {
    "url": "https://github.com/bharat2808/mcp-gsheets",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "gsheets-local-plugin",
      "version": "0.2.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "GSHEETS_GOOGLE_CLIENT_ID",
          "description": "Google OAuth Desktop client ID; optional when a publisher build bundles one",
          "isRequired": false
        },
        {
          "name": "GSHEETS_DATA_DIR",
          "description": "Optional local encrypted-index directory override",
          "isRequired": false
        }
      ]
    }
  ]
}
