# Optional non-secret Desktop OAuth client ID override.
GSHEETS_GOOGLE_CLIENT_ID=

# Optional encrypted-index/config directory override.
GSHEETS_DATA_DIR=

# core is the default; comma-separate categories or use all.
GSHEETS_TOOL_CATEGORIES=core
GSHEETS_READ_ONLY=false

# Explicitly gated credentialed acceptance test (leave disabled by default).
GSHEETS_LIVE_TEST=0
GSHEETS_LIVE_DATA_DIR=
GSHEETS_LIVE_FOLDER_ID=
